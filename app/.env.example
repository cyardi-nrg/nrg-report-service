# Copy this file to .env.local and fill in real values.
# See app/SETUP.md for exactly where each of these comes from.

# 1) Supabase — Project Settings -> API, in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never exposed to the browser. Used for
# the Drive-write/AI-extraction routes, which run with elevated trust.
SUPABASE_SERVICE_ROLE_KEY=

# 2) Google Drive — from the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The Drive folder ID that new project folders get created under
# (open the folder in Drive, copy the ID out of the URL after /folders/)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 3) OpenAI — platform.openai.com -> API keys
OPENAI_API_KEY=
