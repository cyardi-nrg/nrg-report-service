# Design Lab worker v1.0.0 — copy this file to ".env" in the same folder and fill it in.
# The same values the SolarConnect app uses on Railway (Railway → your service → Variables).
# Keep .env private: it holds keys that can read and write the whole database and Drive.

SUPABASE_URL=https://ssloazmdlaofujafcsjo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

GOOGLE_SERVICE_ACCOUNT_EMAIL=paste-from-railway
# Paste the private key exactly as it is on Railway (one line with \n inside is fine).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=paste-from-railway
GOOGLE_DRIVE_ROOT_FOLDER_ID=paste-from-railway

# A name for this computer, shown in the Design Lab ("Chaitanya's MacBook").
WORKER_NAME=Chaitanya's MacBook
